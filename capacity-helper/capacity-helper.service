# Keep the capacity helper running.
#
# Install. The README's download step has already put the binary at
# /usr/local/bin/capacity-helper; run the rest from the root of a clone of this
# repository, which is where the capacity-helper directory below is:
#   sudo install -d -m 0750 -o root -g root /etc/blockmachine
#   printf 'CAPACITY_HELPER_SECRET=%s\n' '<your node secret>' \
#     | sudo tee /etc/blockmachine/capacity-helper.env >/dev/null
#   sudo chmod 0600 /etc/blockmachine/capacity-helper.env
#   sudo cp capacity-helper/capacity-helper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now capacity-helper
#
# On a tao node, change --node to ws://127.0.0.1:9944 and --family to substrate.
#
# --listen below is set for the common case: something on this machine, outside a
# container, forwards /capacity-test to the helper. If you run the gateway stack
# from this repository, the gateway is a container and cannot reach this machine's
# 127.0.0.1, so change --listen to the address Docker gives the host — print it
# with `docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'`,
# almost always 172.17.0.1. See the README section this unit is documented in.

[Unit]
Description=Blockmachine capacity helper
Documentation=https://github.com/taostat/blockmachine-miner#capacity-helper-retired
After=network-online.target
Wants=network-online.target

[Service]
# The secret lives in a file, not here: a unit file is world-readable.
EnvironmentFile=/etc/blockmachine/capacity-helper.env
ExecStart=/usr/local/bin/capacity-helper \
    --node ws://127.0.0.1:8546 \
    --family evm \
    --listen 127.0.0.1:9955
Restart=always
RestartSec=5s

# It needs a network socket and nothing else on this machine.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
