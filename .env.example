# BlockMachine Miner Configuration
# Copy to .env and fill in values: cp .env.example .env

# Authentication secret (generated by install script)
SECRET_V1=
# Secondary secret for zero-downtime rotation (leave empty normally)
SECRET_V2=

# Domain name (used by certbot for auto-renewing TLS)
# Leave empty for self-signed certificates
DOMAIN=

# Chain selection — set by the install script.
#   tao = Bittensor subtensor (default)
#   eth = Ethereum mainnet (reth Latest, reth Archive, or erigon Archive)
CHAIN=tao

# --- Subtensor (CHAIN=tao) ---
BACKEND_PORT=9944

# --- Ethereum (CHAIN=eth) ---
# ETH_TIER (capability-routed by the network gateway):
#   minimal         — general-purpose RPC, recent state only (earns from eth_* at tip)
#   archive   — general-purpose RPC, full archive (earns from trace_*, debug_*, eth_* at any depth, incl. eth_getLogs)
#   proof — proof specialist (earns from eth_getProof only; network policy restricts Erigon to proof traffic)
ETH_TIER=
# EL client: reth (minimal, archive) or erigon (proof). Determined by ETH_TIER.
EL_CLIENT=
# Gateway upstream ports inside the docker network. Reth splits HTTP and WS
# across two ports; erigon serves both on 8545. The install script sets these
# automatically per tier — only override for non-standard setups.
# Defaults: BACKEND_WS_PORT=8546 for reth (minimal, archive), 8545 for proof.
BACKEND_HTTP_PORT=8545
# BACKEND_WS_PORT=8546
# Optional override for the Lighthouse beacon checkpoint-sync source.
# Alternatives: https://beaconstate.info, https://mainnet-checkpoint-sync.attestant.io
CHECKPOINT_SYNC_URL=

# TLS certificate paths inside the container
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
