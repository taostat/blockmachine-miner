# BlockMachine Miner Configuration
# Copy to .env and fill in values: cp .env.example .env
#
# You bring the node — this stack runs only the gateway that fronts it.

# Authentication secret (generated by install script)
SECRET_V1=
# Secondary secret for zero-downtime rotation (leave empty normally)
SECRET_V2=

# Domain name (used by certbot for auto-renewing TLS)
# Leave empty for self-signed certificates
DOMAIN=

# Chain selection — the canonical lower-case chain code you registered for.
CHAIN=tao

# Gateway template: tao (substrate, single WS port) or eth (EVM chains,
# split HTTP/WS ports). Set by the install script from CHAIN.
GATEWAY_TEMPLATE=tao

# Where your node listens. host.docker.internal reaches the host this
# gateway runs on; use an IP or hostname for a node on another machine.
BACKEND_HOST=host.docker.internal

# --- Substrate (GATEWAY_TEMPLATE=tao) ---
BACKEND_PORT=9944

# --- EVM chains (GATEWAY_TEMPLATE=eth) ---
BACKEND_HTTP_PORT=8545
BACKEND_WS_PORT=8546

# Optional: your node client's native Prometheus metrics URL, appended to
# the gateway's /metrics output when set (e.g. http://host.docker.internal:9615/metrics)
NODE_NATIVE_METRICS_URL=

# TLS certificate paths inside the container
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
